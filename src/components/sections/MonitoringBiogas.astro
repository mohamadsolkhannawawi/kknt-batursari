---
import {
  digesterStatus,
  penerimaManfaatList,
  monitoringSummary,
} from "../../data/monitoringBiogas";
---

<section id="monitoring-biogas" class="bg-primary-50/50 py-16 md:py-20 border-t border-neutral-100">
  <div class="container-site max-w-6xl mx-auto px-4">
    
    <!-- HEADER SEKSI -->
    <div class="mb-10 max-w-3xl" data-reveal>
      <h2 class="text-3xl md:text-4xl font-bold text-primary-900">
        {monitoringSummary.title}
      </h2>
      <p class="text-base text-neutral-700 mt-2 leading-relaxed">
        {monitoringSummary.deskripsi}
      </p>
    </div>

    <!-- GRID UTAMA: STATUS DIGESTER (KIRI) + 4 RT PENERIMA MANFAAT (KANAN) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start" data-reveal>
      
      <!-- Status Digester (Kiri - 5/12) -->
      <div class="lg:col-span-5 bg-white p-6 rounded-2xl border border-neutral-200/80 shadow-sm space-y-4">
        <h3 class="font-heading font-semibold text-base text-primary-900 border-b border-neutral-100 pb-3 flex items-center justify-between">
          <span>Status Digester Biogas</span>
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse" title="Sistem Aktif"></span>
        </h3>
        
        <div class="space-y-3.5 text-sm">
          <div>
            <p class="text-xs text-neutral-500 font-medium">Lokasi</p>
            <p class="font-semibold text-neutral-900 mt-0.5">{digesterStatus.lokasi}</p>
          </div>
          <div>
            <p class="text-xs text-neutral-500 font-medium">Periode Pendampingan</p>
            <p class="font-semibold text-primary-800 mt-0.5">{digesterStatus.periodeMonitoring}</p>
          </div>
          <div>
            <p class="text-xs text-neutral-500 font-medium">Status Pengoperasian</p>
            <p class="font-semibold text-neutral-900 mt-0.5">{digesterStatus.statusSistem}</p>
          </div>
          <div>
            <p class="text-xs text-neutral-500 font-medium">Petugas & Tim Pendamping</p>
            <p class="font-semibold text-neutral-900 mt-0.5">{digesterStatus.petugas}</p>
          </div>
        </div>
      </div>

      <!-- 4 Rumah Tangga Penerima Manfaat (Kanan - 7/12) -->
      <div class="lg:col-span-7 bg-white p-6 rounded-2xl border border-neutral-200/80 shadow-sm">
        <h3 class="font-heading font-semibold text-base text-primary-900 border-b border-neutral-100 pb-3 mb-4">
          Penerima Manfaat Kompor Biogas
        </h3>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
          {penerimaManfaatList.map((rt) => (
            <div class="p-4 bg-neutral-50 rounded-xl border border-neutral-100 flex flex-col justify-between hover:border-primary-200 transition-all">
              <div>
                <div class="flex items-center justify-between mb-1">
                  <h4 class="font-bold text-sm text-neutral-900">{rt.nama}</h4>
                  <span class="text-[10px] font-semibold bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-full">
                    {rt.status}
                  </span>
                </div>
                <p class="text-xs text-neutral-500">{rt.alamat}</p>
              </div>

              <div class="mt-4 pt-3 border-t border-neutral-200/60 text-xs">
                <p class="text-neutral-600 leading-relaxed">{rt.catatanPemanfaatan}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>

  </div>
</section>