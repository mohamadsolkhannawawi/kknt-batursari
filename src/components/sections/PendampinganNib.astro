---
import SectionHeading from "../ui/SectionHeading.astro";
import { pendampinganNibData } from "../../data/pendampinganNib";
---

<section id="pendampingan-nib" class="bg-white py-16 md:py-20 border-t border-neutral-100">
  <div class="container-site max-w-5xl mx-auto px-4 space-y-10">
    
    <SectionHeading
      eyebrow="Legalitas & Pemberdayaan UMKM"
      title={pendampinganNibData.judul}
      subtitle={pendampinganNibData.subjudul}
    />

    <div class="bg-white rounded-3xl border border-neutral-200/80 p-6 md:p-10 shadow-sm space-y-8" data-reveal>
      
      <!-- SLIDER CONTAINER -->
      <div class="rounded-2xl border border-neutral-200/80 bg-neutral-50/60 p-4 md:p-6 shadow-xs group">
        <div class="w-full rounded-xl bg-white p-3 border border-neutral-200/80 relative overflow-hidden flex flex-col items-center shadow-inner">
          
          <!-- SLIDER WRAPPER -->
          <div class="relative w-full overflow-hidden rounded-lg min-h-[350px] md:min-h-[480px] flex items-center justify-center bg-neutral-900/5">
            <div id="nibSliderTrack" class="flex w-full h-full transition-transform duration-500 ease-out">
              {pendampinganNibData.galeriGambar.map((item, index) => (
                <div class="w-full flex-shrink-0 flex flex-col items-center justify-center cursor-pointer nib-slide-item" data-index={index}>
                  <img
                    src={item.src}
                    alt={item.alt}
                    loading="lazy"
                    class="w-full h-auto max-h-[480px] object-contain mx-auto rounded-lg"
                  />
                </div>
              ))}
            </div>

            <!-- TOMBOL NAVIGASI SLIDER (KIRI & KANAN) -->
            <button type="button" id="prevNibSlide" class="absolute left-3 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white text-neutral-800 p-2 rounded-full shadow-md backdrop-blur-xs transition-all cursor-pointer z-10" aria-label="Sebelumnya">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
            </button>
            <button type="button" id="nextNibSlide" class="absolute right-3 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white text-neutral-800 p-2 rounded-full shadow-md backdrop-blur-xs transition-all cursor-pointer z-10" aria-label="Selanjutnya">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
            </button>

            <!-- TOMBOL PERBESAR DI POJOK -->
            <div class="absolute bottom-4 right-4 z-20">
              <button
                type="button"
                id="openNibModalBtn"
                class="inline-flex items-center gap-1.5 text-xs font-semibold text-neutral-700 bg-white/95 backdrop-blur-xs border border-neutral-300 px-3.5 py-2 rounded-full shadow-md transition-all duration-300 cursor-pointer hover:bg-emerald-600 hover:text-white hover:border-emerald-600"
              >
                <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607zM10.5 7.5v6m3-3h-6" />
                </svg>
                <span>Perbesar Foto</span>
              </button>
            </div>
          </div>

          <!-- DOTS / INDIKATOR SLIDER & CAPTION DINAMIS -->
          <div class="w-full mt-3 flex flex-col items-center gap-2">
            <div class="flex items-center gap-2" id="nibDotsContainer">
              {pendampinganNibData.galeriGambar.map((_, index) => (
                <button type="button" class="w-2.5 h-2.5 rounded-full transition-all cursor-pointer nib-dot {index === 0 ? 'bg-emerald-600 w-6' : 'bg-neutral-300'}" data-index={index} aria-label={`Slide ${index + 1}`}></button>
              ))}
            </div>
            <div class="p-2.5 bg-white rounded-xl border border-neutral-200/60 text-center w-full shadow-2xs">
              <p class="text-xs md:text-sm text-neutral-600 font-medium" id="nibCaptionText">
                {pendampinganNibData.galeriGambar[0].caption}
              </p>
            </div>
          </div>

        </div>
      </div>

      <!-- DESKRIPSI PARAGRAF -->
      <div class="space-y-4 text-sm md:text-base text-neutral-700 leading-relaxed max-w-none">
        {pendampinganNibData.deskripsi.map((paragraf) => (
          <p>{paragraf}</p>
        ))}
      </div>

      <!-- CTA ARTIKEL REPORTASE -->
      <div class="pt-6 border-t border-neutral-200/60 flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-2 text-xs md:text-sm text-neutral-600 font-medium">
          <svg class="w-5 h-5 text-emerald-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
          </svg>
          <span>Ingin membaca pembahasan reportase lengkap program pendampingan ini?</span>
        </div>

        <a
          href={pendampinganNibData.linkReportase}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm font-semibold text-emerald-900 bg-emerald-100/80 hover:bg-emerald-200/80 px-4 py-2.5 rounded-xl transition-all duration-200 cursor-pointer shrink-0 shadow-2xs"
        >
          <span>Baca Artikel Reportase Lengkap</span>
          <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
          </svg>
        </a>
      </div>

    </div>

  </div>
</section>

<!-- LIGHTBOX MODAL -->
<div
  id="nibModal"
  class="fixed inset-0 z-50 hidden bg-black/90 backdrop-blur-md flex flex-col items-center justify-center p-4 md:p-6 transition-all duration-300 select-none"
>
  <div class="fixed top-4 right-4 md:top-6 md:right-6 z-50 flex items-center gap-3">
    <button
      type="button"
      id="closeNibModal"
      class="p-3 rounded-full bg-white/10 hover:bg-white/20 text-white transition-all duration-200 focus:outline-none cursor-pointer border border-white/20 shadow-lg"
      aria-label="Tutup Modal"
    >
      <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <div class="relative w-full h-full max-w-6xl max-h-[85vh] flex flex-col items-center justify-center p-2">
    <img
      id="modalNibImg"
      src={pendampinganNibData.galeriGambar[0].src}
      alt={pendampinganNibData.judul}
      class="max-w-full max-h-[80vh] object-contain mx-auto rounded-lg shadow-2xl bg-white"
    />
    <p class="text-white text-xs md:text-sm font-medium mt-3 text-center bg-black/50 px-4 py-2 rounded-full border border-white/10 max-w-2xl" id="modalNibCaption">
      {pendampinganNibData.galeriGambar[0].caption}
    </p>
  </div>
</div>

<script define:vars={{ slidesData: pendampinganNibData.galeriGambar }}>
  const track = document.getElementById("nibSliderTrack");
  const dots = document.querySelectorAll(".nib-dot");
  const captionEl = document.getElementById("nibCaptionText");
  const prevBtn = document.getElementById("prevNibSlide");
  const nextBtn = document.getElementById("nextNibSlide");
  
  const modal = document.getElementById("nibModal");
  const openBtn = document.getElementById("openNibModalBtn");
  const closeBtn = document.getElementById("closeNibModal");
  const modalImg = document.getElementById("modalNibImg");
  const modalCaption = document.getElementById("modalNibCaption");

  let currentIndex = 0;
  const totalSlides = slidesData.length;
  let autoSlideInterval;

  function updateSlide(index) {
    if (!track) return;
    currentIndex = (index + totalSlides) % totalSlides;
    track.style.transform = `translateX(-${currentIndex * 100}%)`;

    dots.forEach((dot, idx) => {
      if (idx === currentIndex) {
        dot.classList.add("bg-emerald-600", "w-6");
        dot.classList.remove("bg-neutral-300", "w-2.5");
      } else {
        dot.classList.remove("bg-emerald-600", "w-6");
        dot.classList.add("bg-neutral-300", "w-2.5");
      }
    });

    if (captionEl) {
      captionEl.textContent = slidesData[currentIndex].caption;
    }
    if (modalImg) modalImg.src = slidesData[currentIndex].src;
    if (modalCaption) modalCaption.textContent = slidesData[currentIndex].caption;
  }

  function nextSlide() {
    updateSlide(currentIndex + 1);
  }

  function prevSlide() {
    updateSlide(currentIndex - 1);
  }

  function startAutoSlide() {
    autoSlideInterval = setInterval(nextSlide, 4000);
  }

  function stopAutoSlide() {
    clearInterval(autoSlideInterval);
  }

  nextBtn?.addEventListener("click", () => { nextSlide(); stopAutoSlide(); startAutoSlide(); });
  prevBtn?.addEventListener("click", () => { prevSlide(); stopAutoSlide(); startAutoSlide(); });

  dots.forEach((dot, idx) => {
    dot.addEventListener("click", () => {
      updateSlide(idx);
      stopAutoSlide();
      startAutoSlide();
    });
  });

  track?.addEventListener("mouseenter", stopAutoSlide);
  track?.addEventListener("mouseleave", startAutoSlide);

  startAutoSlide();

  // Modal Logic
  function openModal() {
    if (modal) {
      modal.classList.remove("hidden");
      document.body.style.overflow = "hidden";
    }
  }

  function closeModal() {
    if (modal) {
      modal.classList.add("hidden");
      document.body.style.overflow = "";
    }
  }

  openBtn?.addEventListener("click", openModal);
  track?.addEventListener("click", openModal);
  closeBtn?.addEventListener("click", closeModal);

  modal?.addEventListener("click", (e) => {
    if (e.target === modal) closeModal();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && modal && !modal.classList.contains("hidden")) {
      closeModal();
    }
  });
</script>