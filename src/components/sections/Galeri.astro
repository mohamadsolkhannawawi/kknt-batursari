---
import SectionHeading from "../ui/SectionHeading.astro";
import { galeriList } from "../../data/galeri";

const serializedGaleri = JSON.stringify(galeriList);
---

<section id="galeri" class="bg-neutral-50 py-16 md:py-20 border-t border-neutral-100">
  <div class="container-site max-w-6xl mx-auto px-4">
    <SectionHeading
      title="Dokumentasi Kegiatan"
      subtitle="Momen penerjunan, survei lapangan, audit energi, dan sosialisasi bersama warga Desa Batursari."
    />

    <!-- Wrapper Alpine.js untuk Modal dan Slider -->
    <div
      x-data="{
        modalOpen: false,
        items: [],
        activeIndex: 0,
        intervalId: null,
        init() {
          this.items = JSON.parse(this.$refs.galeriData.textContent || '[]');
        },
        openModal(index) {
          this.activeIndex = index;
          this.modalOpen = true;
          this.startAutoSlide();
        },
        closeModal() {
          this.modalOpen = false;
          this.stopAutoSlide();
        },
        nextSlide() {
          if (this.items.length === 0) return;
          this.activeIndex = (this.activeIndex + 1) % this.items.length;
        },
        prevSlide() {
          if (this.items.length === 0) return;
          this.activeIndex = (this.activeIndex - 1 + this.items.length) % this.items.length;
        },
        goToSlide(index) {
          this.activeIndex = index;
          this.startAutoSlide();
        },
        startAutoSlide() {
          this.stopAutoSlide();
          this.intervalId = setInterval(() => {
            this.nextSlide();
          }, 3500);
        },
        stopAutoSlide() {
          if (this.intervalId) {
            clearInterval(this.intervalId);
            this.intervalId = null;
          }
        }
      }"
      class="relative mt-10"
    >
      <!-- Script tag untuk passing JSON aman ke Alpine -->
      <script type="application/json" x-ref="galeriData" set:html={serializedGaleri}></script>

      <!-- Grid Galeri -->
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        {galeriList.map((foto, index) => (
          <div
            class="flex flex-col justify-between rounded-2xl overflow-hidden border border-neutral-200/80 bg-white group hover:shadow-lg transition-all duration-300"
            data-reveal
          >
            <!-- Image Wrapper -->
            <button
              type="button"
              class="w-full overflow-hidden aspect-[4/3] block relative cursor-zoom-in text-left focus:outline-none"
              x-on:click={`openModal(${index})`}
            >
              <img
                src={foto.src}
                alt={foto.alt}
                loading="lazy"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-black/25 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                <span class="bg-white/90 backdrop-blur-sm text-neutral-800 text-xs font-semibold px-3 py-2 rounded-full shadow-md flex items-center gap-1.5">
                  <svg viewBox="0 0 24 24" class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                  </svg>
                  Lihat Detail
                </span>
              </div>
            </button>

            <!-- Card Info -->
            <div class="p-4 flex flex-col flex-grow justify-between">
              <div>
                {foto.caption && (
                  <p class="text-xs text-neutral-700 leading-relaxed line-clamp-3">
                    {foto.caption}
                  </p>
                )}
              </div>
              
              <div class="mt-4 flex items-center justify-between gap-2 pt-3 border-t border-neutral-100">
                <button
                  type="button"
                  class="text-xs font-semibold text-emerald-700 hover:text-emerald-800 flex items-center gap-1 transition-colors self-start focus:outline-none"
                  x-on:click={`openModal(${index})`}
                >
                  <span>Detail</span>
                  <svg viewBox="0 0 24 24" class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                  </svg>
                </button>

                <!-- Badge Berita di Card Grid jika linkNews ada -->
                {foto.linkNews && (
                  <a
                    href={foto.linkNews.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-xs font-semibold text-emerald-700 hover:text-emerald-900 flex items-center gap-1 transition-colors hover:underline"
                  >
                    <span>JatengVox</span>
                    <svg viewBox="0 0 24 24" class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                    </svg>
                  </a>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Modal Slider -->
      <template x-teleport="body">
        <div
          x-show="modalOpen"
          class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/90 backdrop-blur-md"
          x-transition:enter="transition ease-out duration-300"
          x-transition:enter-start="opacity-0"
          x-transition:enter-end="opacity-100"
          x-transition:leave="transition ease-in duration-200"
          x-transition:leave-start="opacity-100"
          x-transition:leave-end="opacity-0"
          x-on:keydown.escape.window="closeModal()"
          x-cloak
        >
          <!-- Tombol Close -->
          <button
            type="button"
            class="absolute top-6 right-6 text-white/75 hover:text-white text-2xl z-50 p-2 focus:outline-none transition-colors"
            x-on:click="closeModal()"
            aria-label="Tutup Galeri"
          >
            <svg viewBox="0 0 24 24" class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
            </svg>
          </button>

          <!-- Main Container -->
          <div 
            class="w-full max-w-4xl flex flex-col items-center gap-6 mt-8"
            x-on:mouseenter="stopAutoSlide()"
            x-on:mouseleave="startAutoSlide()"
          >
            <!-- Slider Image + Arrows Container -->
            <div class="relative w-full aspect-[16/10] sm:aspect-[16/9] max-h-[50vh] sm:max-h-[60vh] bg-neutral-950 rounded-2xl overflow-hidden shadow-2xl flex items-center justify-center border border-white/10">
              
              <!-- Image Slider -->
              <template x-for="(item, idx) in items" :key="item.id || idx">
                <img
                  x-show="activeIndex === idx"
                  :src="item.src"
                  :alt="item.alt"
                  class="absolute inset-0 w-full h-full object-contain p-2"
                  x-transition:enter="transition ease-out duration-500"
                  x-transition:enter-start="opacity-0 scale-95"
                  x-transition:enter-end="opacity-100 scale-100"
                  x-transition:leave="transition ease-in duration-300"
                  x-transition:leave-start="opacity-100 scale-100"
                  x-transition:leave-end="opacity-0 scale-95"
                />
              </template>

              <!-- Arrow Left -->
              <button
                type="button"
                class="absolute left-4 w-11 h-11 rounded-full bg-white/10 hover:bg-white/20 backdrop-blur-sm text-white flex items-center justify-center transition-colors focus:outline-none"
                x-on:click="prevSlide(); startAutoSlide();"
                aria-label="Slide sebelumnya"
              >
                <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
                </svg>
              </button>

              <!-- Arrow Right -->
              <button
                type="button"
                class="absolute right-4 w-11 h-11 rounded-full bg-white/10 hover:bg-white/20 backdrop-blur-sm text-white flex items-center justify-center transition-colors focus:outline-none"
                x-on:click="nextSlide(); startAutoSlide();"
                aria-label="Slide berikutnya"
              >
                <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                </svg>
              </button>
            </div>

            <!-- Active slide caption & Link News JatengVox -->
            <div class="w-full text-center text-white max-w-3xl px-6">
              <template x-for="(item, idx) in items" :key="item.id || idx">
                <div x-show="activeIndex === idx" class="space-y-3">
                  <h4 class="text-lg sm:text-xl font-bold tracking-tight text-white" x-text="item.alt"></h4>
                  <p class="text-sm sm:text-base text-neutral-300 leading-relaxed" x-text="item.caption"></p>
                  
                  <!-- Tombol JatengVox di dalam Modal (Hanya muncul jika item.linkNews ada) -->
                  <template x-if="item.linkNews">
                    <div class="pt-2">
                      <a
                        :href="item.linkNews.url"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 px-5 py-2.5 text-xs sm:text-sm font-semibold text-white bg-emerald-600 hover:bg-emerald-500 rounded-full shadow-lg transition-all transform hover:-translate-y-0.5"
                      >
                        <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M12 7.5h1.5m-1.5 3h1.5m-7.5 3h7.5m-7.5 3h7.5m3-9h3.75a2.25 2.25 0 0 1 2.25 2.25v7.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25v-7.5A2.25 2.25 0 0 1 4.5 7.5H9m3 0V4.5a2.25 2.25 0 0 0-2.25-2.25H6.75A2.25 2.25 0 0 0 4.5 4.5v3" />
                        </svg>
                        <span x-text="item.linkNews.label || 'Baca berita selengkapnya di JatengVox'"></span>
                        <svg viewBox="0 0 24 24" class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                        </svg>
                      </a>
                    </div>
                  </template>
                </div>
              </template>
            </div>

            <!-- Dots Indicators -->
            <div class="flex gap-2">
              <template x-for="(item, idx) in items" :key="item.id || idx">
                <button
                  type="button"
                  class="w-2.5 h-2.5 rounded-full transition-all duration-300 focus:outline-none"
                  :class="activeIndex === idx ? 'bg-emerald-500 scale-125' : 'bg-white/30 hover:bg-white/50'"
                  x-on:click="goToSlide(idx)"
                  :aria-label="'Pergi ke slide ' + (idx + 1)"
                ></button>
              </template>
            </div>
          </div>
        </div>
      </template>
    </div>
  </div>
</section>