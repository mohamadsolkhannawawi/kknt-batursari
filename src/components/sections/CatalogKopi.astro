---
import SectionHeading from "../ui/SectionHeading.astro";
import { catalogKopiData } from "../../data/catalogKopi";
---

<section id="catalog-kopi" class="bg-white py-16 md:py-20 border-t border-neutral-100">
  <div class="container-site max-w-6xl mx-auto px-4 space-y-10">
    
    <SectionHeading
      eyebrow={catalogKopiData.kategori}
      title={catalogKopiData.judul}
      subtitle={catalogKopiData.subjudul}
    />

    <div class="bg-white rounded-3xl border border-neutral-200/80 p-6 md:p-10 shadow-sm space-y-8" data-reveal>
      
      <!-- CARD PREVIEW GAMBAR UTAMA -->
      <div class="rounded-2xl border border-neutral-200/80 bg-neutral-50/60 p-4 md:p-6 shadow-xs group">
        <div class="w-full rounded-xl bg-white p-3 border border-neutral-200/80 relative overflow-hidden flex flex-col items-center shadow-inner">
          
          <div class="w-full flex items-center justify-center relative overflow-hidden rounded-lg cursor-pointer" id="triggerKopiImg">
            <img
              src={catalogKopiData.galeriGambar[0].src}
              alt={catalogKopiData.galeriGambar[0].alt}
              loading="lazy"
              class="w-full h-auto object-contain mx-auto rounded-lg transition-transform duration-500 ease-out group-hover:scale-[1.02]"
            />

            <!-- FLOATING BUTTON PERBESAR -->
            <div class="absolute bottom-4 right-4 z-20">
              <button
                type="button"
                id="openKopiModalBtn"
                class="inline-flex items-center gap-1.5 text-xs font-semibold text-neutral-700 bg-white/95 backdrop-blur-xs border border-neutral-300 px-3.5 py-2 rounded-full shadow-md transition-all duration-300 cursor-pointer hover:bg-emerald-600 hover:text-white hover:border-emerald-600"
              >
                <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607zM10.5 7.5v6m3-3h-6" />
                </svg>
                <span>Perbesar Desain</span>
              </button>
            </div>
          </div>

          <!-- KOTAK CAPTION BAWAH GAMBAR -->
          <div class="p-3 bg-white rounded-xl mt-3 border border-neutral-200/60 text-center w-full shadow-2xs">
            <p class="text-xs md:text-sm text-neutral-600 font-medium">
              {catalogKopiData.galeriGambar[0].caption}
            </p>
          </div>

        </div>
      </div>

      <!-- DESKRIPSI PARAGRAF YANG DIPANJANGKAN -->
      <div class="space-y-4 text-sm md:text-base text-neutral-700 leading-relaxed max-w-none">
        {catalogKopiData.deskripsi.map((paragraf) => (
          <p>{paragraf}</p>
        ))}
      </div>

      <!-- CTA KE ARTIKEL REPORTASE -->
      <div class="pt-6 border-t border-neutral-200/60 flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-2 text-xs md:text-sm text-neutral-600 font-medium">
          <svg class="w-5 h-5 text-emerald-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
          </svg>
          <span>Ingin membaca pembahasan reportase lengkap program ini?</span>
        </div>

        <a
          href={catalogKopiData.linkReportase}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm font-semibold text-emerald-900 bg-emerald-100/80 hover:bg-emerald-200/80 px-4 py-2.5 rounded-xl transition-all duration-200 cursor-pointer shrink-0 shadow-2xs"
        >
          <span>Baca Artikel Reportase Lengkap</span>
          <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
          </svg>
        </a>
      </div>

    </div>

  </div>
</section>

<!-- LIGHTBOX MODAL -->
<div
  id="kopiModal"
  class="fixed inset-0 z-50 hidden bg-black/90 backdrop-blur-md flex flex-col items-center justify-center p-4 md:p-6 transition-all duration-300 select-none"
>
  <div class="fixed top-4 right-4 md:top-6 md:right-6 z-50 flex items-center gap-3">
    <a
      href={catalogKopiData.galeriGambar[0].src}
      download="Dokumentasi-E-Catalogue-Al-Haris-Coffee.jpg"
      class="p-3 rounded-full bg-white/10 hover:bg-emerald-600 text-white transition-all duration-200 focus:outline-none cursor-pointer border border-white/20 shadow-lg flex items-center justify-center"
      title="Unduh Gambar"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
      </svg>
    </a>

    <button
      type="button"
      id="closeKopiModal"
      class="p-3 rounded-full bg-white/10 hover:bg-white/20 text-white transition-all duration-200 focus:outline-none cursor-pointer border border-white/20 shadow-lg"
      aria-label="Tutup Modal"
    >
      <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <div class="relative w-full h-full max-w-6xl max-h-[85vh] flex flex-col items-center justify-center p-2">
    <img
      src={catalogKopiData.galeriGambar[0].src}
      alt={catalogKopiData.galeriGambar[0].alt}
      class="max-w-full max-h-[80vh] object-contain mx-auto rounded-lg shadow-2xl"
    />
    <p class="text-white text-xs md:text-sm font-medium mt-3 text-center bg-black/50 px-4 py-2 rounded-full border border-white/10 max-w-2xl">
      {catalogKopiData.galeriGambar[0].caption}
    </p>
  </div>
</div>

<script>
  const kopiModal = document.getElementById("kopiModal");
  const openKopiBtn = document.getElementById("openKopiModalBtn");
  const triggerKopiImg = document.getElementById("triggerKopiImg");
  const closeKopiBtn = document.getElementById("closeKopiModal");

  function openModalKopi() {
    if (kopiModal) {
      kopiModal.classList.remove("hidden");
      document.body.style.overflow = "hidden";
    }
  }

  function closeModalKopi() {
    if (kopiModal) {
      kopiModal.classList.add("hidden");
      document.body.style.overflow = "";
    }
  }

  openKopiBtn?.addEventListener("click", openModalKopi);
  triggerKopiImg?.addEventListener("click", openModalKopi);
  closeKopiBtn?.addEventListener("click", closeModalKopi);

  kopiModal?.addEventListener("click", (e) => {
    if (e.target === kopiModal) closeModalKopi();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && kopiModal && !kopiModal.classList.contains("hidden")) {
      closeModalKopi();
    }
  });
</script>