---
import SectionHeading from "../ui/SectionHeading.astro";
import { monografData } from "../../data/monografData";
---

<section id="monograf" class="bg-white py-16 md:py-20 border-t border-neutral-100">
  <div class="container-site max-w-6xl mx-auto px-4 space-y-10">
    
    <!-- HEADER SEKSI -->
    <SectionHeading
      eyebrow="PUBLIKASI & BUKU MONOGRAF"
      title={monografData.judul}
      subtitle={monografData.subjudul}
    />

    <!-- CONTAINER UTAMA KESIMPULAN -->
    <div class="bg-neutral-50/80 rounded-2xl border border-neutral-200/80 p-6 md:p-8 shadow-sm space-y-8" data-reveal>
      
      <!-- PARAGRAF NARASI KESIMPULAN -->
      <div class="space-y-4 text-base text-neutral-700 leading-relaxed max-w-4xl mx-auto">
        <h3 class="text-lg md:text-xl font-bold text-emerald-950 mb-2">
          Ringkasan & Kesimpulan Buku Monograf
        </h3>

        {monografData.kesimpulan.map((paragraf) => (
          <p>{paragraf}</p>
        ))}
      </div>

      <!-- BOTTOM CTA DIRECT LINK TO DRAFT BUKU (DENGAN LOGO/IKON KORAN PERSIS) -->
      <div class="pt-6 border-t border-neutral-200/80 flex flex-wrap items-center justify-between gap-4 max-w-4xl mx-auto">
        
        <!-- TEKS DAN LOGO KORAN KETIK DIPANGGIL -->
        <div class="flex items-center gap-2 text-xs md:text-sm text-neutral-600 font-medium">
          <!-- LOGO / IKON KORAN (NEWSPAPER) -->
          <svg class="w-5 h-5 text-emerald-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
          </svg>
          <span>Ingin membaca draf dokumen monograf secara utuh?</span>
        </div>

        <!-- TOMBOL CTA DIRECT LINK -->
        <a
          href={monografData.draftUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-xs md:text-sm font-semibold text-emerald-900 bg-emerald-100/80 hover:bg-emerald-200/80 px-4 py-2.5 rounded-xl transition-all duration-200 cursor-pointer shrink-0 shadow-2xs"
        >
          <span>Buka Draf Buku Monograf</span>
          <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
          </svg>
        </a>

      </div>

    </div>

  </div>
</section>
