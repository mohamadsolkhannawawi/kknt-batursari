---
import SectionHeading from "../ui/SectionHeading.astro";
import {
  pocSummary,
  galeriGambarPoc,
  penjelasanKegiatanPoc,
  linkReportasePoc,
} from "../../data/skemaBiogas";

// LINK GOOGLE DRIVE VIDEO TUTORIAL PEMBUATAN POC
const linkVideoPoc = "https://youtu.be/U0FM2QnFOCQ"; 
---

<section id="poc" class="bg-white py-16 md:py-20 border-t border-neutral-100">
  <div class="container-site max-w-6xl mx-auto px-4">
    
    <!-- HEADER SEKSI -->
    <SectionHeading
      eyebrow="Edukasi Lingkungan"
      title={pocSummary.title}
      subtitle={pocSummary.deskripsi}
    />

    <!-- CONTAINER UTAMA -->
    <div class="bg-neutral-50/80 rounded-2xl border border-neutral-200/80 p-6 md:p-8 mt-10 shadow-sm" data-reveal>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
        
        <!-- KOLOM KIRI: CAROUSEL GAMBAR SLIDER (AUTOSLIDE & COMPACT) -->
        <div class="lg:col-span-5 rounded-xl border border-neutral-200/80 bg-white p-2 shadow-sm group h-fit">
          <div class="w-full rounded-lg bg-neutral-100/80 p-2 relative overflow-hidden flex flex-col items-center">
            
            <!-- WADAH SLIDE GAMBAR -->
            <div id="pocSliderContainer" class="w-full flex items-center justify-center relative aspect-[4/3] overflow-hidden rounded-md">
              {galeriGambarPoc.map((img, idx) => (
                <div 
                  class={`poc-slide w-full h-full flex items-center justify-center transition-opacity duration-500 ${idx === 0 ? 'opacity-100 relative z-10' : 'opacity-0 absolute inset-0 z-0'}`}
                  data-index={idx}
                >
                  <img
                    src={img.src}
                    alt={img.alt}
                    loading="lazy"
                    class="w-full h-full object-contain mx-auto rounded-md cursor-pointer trigger-poc-modal transition-transform duration-500 ease-out hover:scale-105"
                    data-img-src={img.src}
                    data-img-alt={img.alt}
                    data-index={idx}
                  />
                </div>
              ))}

              <!-- FLOATING BUTTON PERBESAR (POJOK KANAN BAWAH GAMBAR) -->
              <div class="absolute bottom-3 right-3 z-20">
                <button
                  type="button"
                  id="openPocModalBtn"
                  class="inline-flex items-center gap-1.5 text-xs font-semibold text-neutral-700 bg-white/95 backdrop-blur-xs border border-neutral-300 px-3 py-1.5 rounded-full shadow-md transition-all duration-300 cursor-pointer hover:bg-emerald-600 hover:text-white hover:border-emerald-600"
                >
                  <svg viewBox="0 0 24 24" class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607zM10.5 7.5v6m3-3h-6" />
                  </svg>
                  <span>Perbesar</span>
                </button>
              </div>
            </div>

            <!-- KOTAK CAPTION DINAMIS DI BAWAH SLIDER UTAMA -->
            <div class="p-2.5 bg-white rounded-lg mt-2 border border-neutral-100 text-center w-full z-10 shadow-2xs">
              <p id="pocCaptionText" class="text-xs text-neutral-600 font-medium leading-relaxed">
                {galeriGambarPoc[0].caption}
              </p>
            </div>

            <!-- TOMBOL PANAH PREV & NEXT SLIDER UTAMA -->
            <button 
              type="button" 
              id="pocPrevBtn"
              class="absolute left-3 top-[40%] -translate-y-1/2 z-20 w-8 h-8 rounded-full bg-white/90 hover:bg-emerald-600 hover:text-white text-neutral-800 shadow-md flex items-center justify-center transition-all cursor-pointer"
              aria-label="Previous Slide"
            >
              ❮
            </button>
            <button 
              type="button" 
              id="pocNextBtn"
              class="absolute right-3 top-[40%] -translate-y-1/2 z-20 w-8 h-8 rounded-full bg-white/90 hover:bg-emerald-600 hover:text-white text-neutral-800 shadow-md flex items-center justify-center transition-all cursor-pointer"
              aria-label="Next Slide"
            >
              ❯
            </button>

            <!-- DOT INDICATOR -->
            <div class="flex items-center justify-center gap-1.5 mt-2 z-20">
              {galeriGambarPoc.map((_, idx) => (
                <button 
                  type="button"
                  class={`poc-dot w-2 h-2 rounded-full transition-all cursor-pointer ${idx === 0 ? 'bg-emerald-600 w-5' : 'bg-neutral-300'}`}
                  data-slide-to={idx}
                  aria-label={`Go to slide ${idx + 1}`}
                />
              ))}
            </div>

          </div>
        </div>

        <!-- KOLOM KANAN: PENJELASAN KEGIATAN & CTA VIDEO TUTORIAL -->
        <div class="lg:col-span-7 flex flex-col justify-between space-y-6">
          <div class="space-y-4 text-sm md:text-base text-neutral-700 leading-relaxed">
            {penjelasanKegiatanPoc.map((paragraf) => (
              <p>{paragraf}</p>
            ))}
          </div>

          <!-- BOTTOM CTA LINK VIDEO PEMBUATAN POC -->
          <div class="pt-4 border-t border-neutral-200/60 flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center gap-2 text-xs md:text-sm text-neutral-600 font-medium">
              <!-- IKON KAMERA VIDEO -->
              <svg class="w-5 h-5 text-emerald-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              <span>Ingin melihat video tutorial pembuatan POC?</span>
            </div>

            <a
              href={linkVideoPoc}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-xs md:text-sm font-semibold text-emerald-900 bg-emerald-100/80 hover:bg-emerald-200/80 px-4 py-2.5 rounded-xl transition-all duration-200 cursor-pointer shrink-0 shadow-2xs"
            >
              <!-- IKON PLAY -->
              <svg class="w-4 h-4 text-emerald-900 fill-current shrink-0" viewBox="0 0 24 24">
                <path d="M8 5v14l11-7z" />
              </svg>
              <span>Tonton Video Pembuatan</span>
              <!-- IKON EXTERNAL LINK -->
              <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
              </svg>
            </a>
          </div>
        </div>

      </div>
    </div>

  </div>
</section>

<!-- LIGHTBOX MODAL DENGAN PANAH NAVIGASI, TOMBOL UNDUH, & CAPTION DINAMIS -->
<div
  id="pocModal"
  class="fixed inset-0 z-50 hidden bg-black/90 backdrop-blur-md flex flex-col items-center justify-center p-4 md:p-6 transition-all duration-300 select-none"
>
  <!-- KELOMPOK TOMBOL POJOK KANAN ATAS (UNDUH & CLOSE) -->
  <div class="fixed top-4 right-4 md:top-6 md:right-6 z-50 flex items-center gap-3">
    <!-- 📥 TOMBOL UNDUH GAMBAR -->
    <a
      id="pocModalDownloadBtn"
      href=""
      download="Dokumentasi-POC.jpg"
      class="p-3 rounded-full bg-white/10 hover:bg-emerald-600 text-white transition-all duration-200 focus:outline-none cursor-pointer border border-white/20 shadow-lg flex items-center justify-center"
      title="Unduh Gambar Ini"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
      </svg>
    </a>

    <!-- ✖ TOMBOL SILANG CLOSE -->
    <button
      type="button"
      id="closePocModal"
      class="p-3 rounded-full bg-white/10 hover:bg-white/20 text-white transition-all duration-200 focus:outline-none cursor-pointer border border-white/20 shadow-lg"
      aria-label="Tutup Modal"
    >
      <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- WADAH UTAMA MODAL SLIDER -->
  <div class="relative w-full h-full max-w-6xl max-h-[85vh] flex flex-col items-center justify-center p-2">
    
    <!-- GAMBAR MODAL TANPA FRAMING PUTIH -->
    <img
      id="pocModalImg"
      src=""
      alt=""
      class="max-w-full max-h-[80vh] object-contain mx-auto rounded-lg shadow-2xl transition-all duration-300"
    />

    <!-- CAPTION TERSEDIA DI DALAM MODAL -->
    <p id="pocModalCaption" class="text-white text-xs md:text-sm font-medium mt-3 text-center bg-black/50 px-4 py-2 rounded-full border border-white/10 max-w-2xl">
    </p>

    <!-- TOMBOL PREV MODAL (NAVIGASI KIRI) -->
    <button
      type="button"
      id="pocModalPrevBtn"
      class="fixed left-4 md:left-8 top-1/2 -translate-y-1/2 z-50 w-12 h-12 rounded-full bg-white/20 hover:bg-emerald-600 text-white shadow-xl flex items-center justify-center transition-all cursor-pointer border border-white/20 backdrop-blur-sm text-xl"
      aria-label="Gambar Sebelumnya"
    >
      ❮
    </button>

    <!-- TOMBOL NEXT MODAL (NAVIGASI KANAN) -->
    <button
      type="button"
      id="pocModalNextBtn"
      class="fixed right-4 md:right-8 top-1/2 -translate-y-1/2 z-50 w-12 h-12 rounded-full bg-white/20 hover:bg-emerald-600 text-white shadow-xl flex items-center justify-center transition-all cursor-pointer border border-white/20 backdrop-blur-sm text-xl"
      aria-label="Gambar Selanjutnya"
    >
      ❯
    </button>

  </div>
</div>

<!-- SCRIPT AUTOSLIDE CAROUSEL, CAPTION UPDATE, & MODAL SLIDER -->
<script>
  let currentSlide = 0;
  const slides = document.querySelectorAll(".poc-slide");
  const dots = document.querySelectorAll(".poc-dot");
  const captionEl = document.getElementById("pocCaptionText");
  const totalSlides = slides.length;
  let autoSlideTimer: number;

  // Elemen Lightbox Modal
  const modal = document.getElementById("pocModal");
  const modalImg = document.getElementById("pocModalImg") as HTMLImageElement;
  const modalCaption = document.getElementById("pocModalCaption");
  const modalDownloadBtn = document.getElementById("pocModalDownloadBtn") as HTMLAnchorElement;
  const openModalBtn = document.getElementById("openPocModalBtn");
  const closeBtn = document.getElementById("closePocModal");
  const modalPrevBtn = document.getElementById("pocModalPrevBtn");
  const modalNextBtn = document.getElementById("pocModalNextBtn");

  function updateModalData(index: number) {
    const slideImg = slides[index]?.querySelector("img") as HTMLImageElement;
    if (slideImg && modalImg) {
      modalImg.src = slideImg.src;
      modalImg.alt = slideImg.alt;
      if (modalCaption) {
        modalCaption.textContent = slideImg.alt || "Dokumen Foto Kegiatan POC";
      }
      if (modalDownloadBtn) {
        modalDownloadBtn.href = slideImg.src;
      }
    }
  }

  function showSlide(index: number) {
    slides.forEach((slide, i) => {
      if (i === index) {
        slide.classList.remove("opacity-0", "z-0", "absolute");
        slide.classList.add("opacity-100", "z-10", "relative");
        
        const activeImg = slide.querySelector("img") as HTMLImageElement;
        if (activeImg && captionEl) {
          captionEl.textContent = activeImg.alt || "Dokumen Program POC";
        }
      } else {
        slide.classList.remove("opacity-100", "z-10", "relative");
        slide.classList.add("opacity-0", "z-0", "absolute");
      }
    });

    dots.forEach((dot, i) => {
      if (i === index) {
        dot.classList.add("bg-emerald-600", "w-5");
        dot.classList.remove("bg-neutral-300");
      } else {
        dot.classList.remove("bg-emerald-600", "w-5");
        dot.classList.add("bg-neutral-300");
      }
    });

    currentSlide = index;

    // Jika modal terbuka, ikut sinkronkan gambar, caption, dan link download di dalam modal
    if (modal && !modal.classList.contains("hidden")) {
      updateModalData(currentSlide);
    }
  }

  function nextSlide() {
    const next = (currentSlide + 1) % totalSlides;
    showSlide(next);
  }

  function prevSlide() {
    const prev = (currentSlide - 1 + totalSlides) % totalSlides;
    showSlide(prev);
  }

  function startAutoSlide() {
    autoSlideTimer = window.setInterval(nextSlide, 4000);
  }

  function stopAutoSlide() {
    clearInterval(autoSlideTimer);
  }

  // Event Listeners Slider Utama
  document.getElementById("pocNextBtn")?.addEventListener("click", () => {
    stopAutoSlide();
    nextSlide();
    startAutoSlide();
  });

  document.getElementById("pocPrevBtn")?.addEventListener("click", () => {
    stopAutoSlide();
    prevSlide();
    startAutoSlide();
  });

  dots.forEach((dot) => {
    dot.addEventListener("click", (e) => {
      const idx = parseInt((e.currentTarget as HTMLElement).getAttribute("data-slide-to") || "0");
      stopAutoSlide();
      showSlide(idx);
      startAutoSlide();
    });
  });

  // Modal Lightbox & Slider Navigasi
  function openModal(index: number) {
    if (modal) {
      showSlide(index);
      modal.classList.remove("hidden");
      document.body.style.overflow = "hidden";
    }
  }

  function closeModal() {
    if (modal) {
      modal.classList.add("hidden");
      document.body.style.overflow = "";
    }
  }

  document.querySelectorAll(".trigger-poc-modal").forEach((img) => {
    img.addEventListener("click", (e) => {
      const target = e.currentTarget as HTMLImageElement;
      const idx = parseInt(target.getAttribute("data-index") || "0");
      openModal(idx);
    });
  });

  openModalBtn?.addEventListener("click", () => {
    openModal(currentSlide);
  });

  // Tombol Panah Prev / Next di Modal
  modalPrevBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    stopAutoSlide();
    prevSlide();
    startAutoSlide();
  });

  modalNextBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    stopAutoSlide();
    nextSlide();
    startAutoSlide();
  });

  closeBtn?.addEventListener("click", closeModal);
  modal?.addEventListener("click", (e) => {
    if (e.target === modal) closeModal();
  });

  // Navigasi Keyboard Panah Kiri (`←`) / Kanan (`→`) saat Modal Terbuka
  document.addEventListener("keydown", (e) => {
    if (modal && !modal.classList.contains("hidden")) {
      if (e.key === "ArrowLeft") {
        stopAutoSlide();
        prevSlide();
        startAutoSlide();
      } else if (e.key === "ArrowRight") {
        stopAutoSlide();
        nextSlide();
        startAutoSlide();
      } else if (e.key === "Escape") {
        closeModal();
      }
    }
  });

  // Start autoslide pas load
  startAutoSlide();
</script>