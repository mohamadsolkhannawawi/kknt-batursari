---
import SectionHeading from "../ui/SectionHeading.astro";
import { timList } from "../../data/tim";

// Menampilkan semua anggota Multi Disiplin 1 & Multi Disiplin 2
const multi1 = timList.filter((a) => a.multiGroup === "multidisiplin-1");
const multi2 = timList.filter((a) => a.multiGroup === "multidisiplin-2");
---

<section id="tim" class="bg-white py-16 md:py-20 border-t border-neutral-100">
  <div class="container-site max-w-6xl mx-auto px-4">
    <SectionHeading
      eyebrow="TIM KKN-T DESA BATURSARI"
      title="Tim Penyusun Program"
      subtitle="Website ini adalah hasil kerja kolektif seluruh 15 mahasiswa KKN-T 141 kelompok 2 Desa Batursari yang sudah dikelompokkan sesuai peran Multi Disiplin 1 & Multi Disiplin 2."
    />

    <!-- SUB-SECTION: TIM MULTI 1 -->
    <div class="mt-10 mb-16">
      <h3 class="text-lg font-bold text-emerald-950 mb-1" data-reveal>
        Tim Multi Disiplin 1 — Audit Energi & Pemetaan EBT
      </h3>
      <p class="text-sm text-neutral-500 mb-6" data-reveal>
        {multi1.length} anggota
      </p>

      <!-- CONTAINER GRID KARTU FLIP MULTI 1 -->
      <div class="flex flex-wrap justify-center gap-6">
        {multi1.map((anggota) => (
          <div 
            class="group flipped-card w-full sm:w-[calc(50%-0.75rem)] md:w-[calc(33.33%-1rem)] lg:w-[calc(25%-1.15rem)] max-w-[270px] h-[360px] [perspective:1000px] select-none"
            data-reveal
          >
            <!-- CONTAINER CARD UTAMA (FLIP SAAT HOVER / KLIK MOBILE) -->
            <div class="relative h-full w-full rounded-2xl shadow-xs transition-transform duration-700 [transform-style:preserve-3d] group-hover:[transform:rotateY(180deg)] group-[.flipped]:[transform:rotateY(180deg)] cursor-pointer">
              
              <!-- === SISI DEPAN (CLEAN PROFIL DASAR) === -->
              <div class="absolute inset-0 h-full w-full rounded-2xl border border-neutral-200/80 bg-white p-6 flex flex-col items-center justify-center text-center [backface-visibility:hidden]">
                
                <!-- FOTO ANGGOTA -->
                <div class="w-24 h-24 aspect-square rounded-full overflow-hidden border-2 border-emerald-500/20 shadow-xs bg-neutral-100 flex items-center justify-center shrink-0 mb-4 relative">
                  <img
                    src={anggota.foto}
                    alt={anggota.nama}
                    loading="lazy"
                    class={`w-full h-full object-cover transition-transform duration-300 ${anggota.fotoClass || 'object-center'}`}
                  />
                </div>

                <!-- INFORMASI IDENTITAS -->
                <div class="space-y-1 w-full">
                  <h4 class="text-base font-bold text-neutral-900 leading-snug line-clamp-2">
                    {anggota.nama}
                  </h4>
                  <p class="text-xs text-neutral-500 font-medium">NIM: {anggota.nim}</p>
                  <p class="text-xs text-neutral-700 font-semibold">{anggota.prodi}</p>
                  <p class="text-[11px] text-neutral-400">{anggota.fakultas}</p>
                </div>

              </div>

              <!-- === SISI BELAKANG === -->
              <div class="absolute inset-0 h-full w-full rounded-2xl border border-emerald-500/40 bg-gradient-to-br from-emerald-600 via-emerald-700 to-emerald-800 p-6 flex flex-col justify-between text-center text-white [backface-visibility:hidden] [transform:rotateY(180deg)] shadow-lg">
                
                <div class="my-auto space-y-3 w-full">
                  <span class="inline-block px-3 py-1 rounded-full bg-emerald-500/30 text-emerald-100 text-[11px] font-semibold border border-emerald-400/30">
                    Program Kerja / Peran
                  </span>
                  
                  <h5 class="text-sm font-bold text-white leading-tight">
                    {anggota.nama}
                  </h5>

                  <!-- OUTPUT INDIVIDUAL -->
                  <div class="p-3.5 bg-white/15 backdrop-blur-xs rounded-xl border border-white/20 text-xs text-white leading-relaxed max-h-[170px] overflow-y-auto text-center font-normal">
                    {anggota.output}
                  </div>

                  {anggota.instagram && (
                    <a
                      href={anggota.instagram}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-white/15 hover:bg-white/30 text-white transition-all hover:scale-110 mt-2 mx-auto"
                      title={`Instagram ${anggota.nama}`}
                      onclick="event.stopPropagation()"
                    >
                      <i class="fab fa-instagram text-lg"></i>
                    </a>
                  )}
                </div>

                <p class="text-[10px] text-emerald-100/80 italic pt-2 border-t border-emerald-500/40">
                  KKN-T 141 Undip Desa Batursari
                </p>

              </div>

            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- SUB-SECTION: TIM MULTI 2 -->
    <div class="mb-10">
      <h3 class="text-lg font-bold text-emerald-950 mb-1" data-reveal>
        Tim Multi Disiplin 2 — Sosialisasi & Kelembagaan
      </h3>
      <p class="text-sm text-neutral-500 mb-6" data-reveal>
        {multi2.length} anggota
      </p>

      <!-- CONTAINER GRID KARTU FLIP MULTI 2 -->
      <div class="flex flex-wrap justify-center gap-6">
        {multi2.map((anggota) => (
          <div 
            class="group flipped-card w-full sm:w-[calc(50%-0.75rem)] md:w-[calc(33.33%-1rem)] lg:w-[calc(25%-1.15rem)] max-w-[270px] h-[360px] [perspective:1000px] select-none"
            data-reveal
          >
            <!-- CONTAINER CARD UTAMA (FLIP SAAT HOVER / KLIK MOBILE) -->
            <div class="relative h-full w-full rounded-2xl shadow-xs transition-transform duration-700 [transform-style:preserve-3d] group-hover:[transform:rotateY(180deg)] group-[.flipped]:[transform:rotateY(180deg)] cursor-pointer">
              
              <!-- === SISI DEPAN (CLEAN PROFIL DASAR) === -->
              <div class="absolute inset-0 h-full w-full rounded-2xl border border-neutral-200/80 bg-white p-6 flex flex-col items-center justify-center text-center [backface-visibility:hidden]">
                
                <!-- FOTO ANGGOTA -->
                <div class="w-24 h-24 aspect-square rounded-full overflow-hidden border-2 border-emerald-500/20 shadow-xs bg-neutral-100 flex items-center justify-center shrink-0 mb-4">
                  <img
                    src={anggota.foto}
                    alt={anggota.nama}
                    loading="lazy"
                    class="w-full h-full object-cover object-center"
                  />
                </div>

                <!-- INFORMASI IDENTITAS -->
                <div class="space-y-1 w-full">
                  <h4 class="text-base font-bold text-neutral-900 leading-snug line-clamp-2">
                    {anggota.nama}
                  </h4>
                  <p class="text-xs text-neutral-500 font-medium">NIM: {anggota.nim}</p>
                  <p class="text-xs text-neutral-700 font-semibold">{anggota.prodi}</p>
                  <p class="text-[11px] text-neutral-400">{anggota.fakultas}</p>
                </div>

              </div>

              <!-- === SISI BELAKANG === -->
              <div class="absolute inset-0 h-full w-full rounded-2xl border border-emerald-500/40 bg-gradient-to-br from-emerald-600 via-emerald-700 to-emerald-800 p-6 flex flex-col justify-between text-center text-white [backface-visibility:hidden] [transform:rotateY(180deg)] shadow-lg">
                
                <div class="my-auto space-y-3 w-full">
                  <span class="inline-block px-3 py-1 rounded-full bg-emerald-500/30 text-emerald-100 text-[11px] font-semibold border border-emerald-400/30">
                    Program Kerja / Peran
                  </span>
                  
                  <h5 class="text-sm font-bold text-white leading-tight">
                    {anggota.nama}
                  </h5>

                  <!-- OUTPUT INDIVIDUAL -->
                  <div class="p-3.5 bg-white/15 backdrop-blur-xs rounded-xl border border-white/20 text-xs text-white leading-relaxed max-h-[170px] overflow-y-auto text-center font-normal">
                    {anggota.output}
                  </div>

                  {anggota.instagram && (
                    <a
                      href={anggota.instagram}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-white/15 hover:bg-white/30 text-white transition-all hover:scale-110 mt-2 mx-auto"
                      title={`Instagram ${anggota.nama}`}
                      onclick="event.stopPropagation()"
                    >
                      <i class="fab fa-instagram text-lg"></i>
                    </a>
                  )}
                </div>

                <p class="text-[10px] text-emerald-100/80 italic pt-2 border-t border-emerald-500/40">
                  KKN-T 141 Undip Desa Batursari
                </p>

              </div>

            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<!-- SCRIPT TOGGLE FLIP ON CLICK / TAP -->
<script>
  document.querySelectorAll('.flipped-card').forEach((card) => {
    card.addEventListener('click', () => {
      card.classList.toggle('flipped');
    });
  });
</script>
