---
import SectionHeading from "../ui/SectionHeading.astro";
import {
  lokasiAudit,
  hasilAuditList,
  rekomendasiUmum,
} from "../../data/auditEnergi";
---

<section id="audit" class="bg-neutral-50 py-16 md:py-20 border-t border-neutral-200/80">
  <div class="container-site max-w-6xl mx-auto px-4">
    
    <!-- HEADER SEKSI -->
    <SectionHeading
      eyebrow="Program Konservasi Energi"
      title="Audit Energi di SMP Negeri 3 Mranggen"
      subtitle={lokasiAudit.deskripsi}
    />

    <!-- TABEL HASIL AUDIT ENERGI -->
    <div class="bg-white rounded-2xl border border-neutral-200/80 shadow-sm overflow-hidden mb-10" data-reveal>
      <div class="p-6 border-b border-neutral-100 bg-white">
        <h3 class="text-lg font-bold text-primary-900">
          Tabel Ringkasan Hasil Audit & Potensi Efisiensi
        </h3>
        <p class="text-xs text-neutral-500 mt-1">
          Pemeriksaan beban kelistrikan dan kondisi eksisting pencahayaan di area SMP Negeri 3 Mranggen.
        </p>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-neutral-700">
          <thead class="bg-neutral-100/80 text-xs uppercase tracking-wider text-neutral-600 border-b border-neutral-200/80">
            <tr>
              <th scope="col" class="py-3.5 px-5 font-bold">Area Pemeriksaan</th>
              <th scope="col" class="py-3.5 px-5 font-bold">Peralatan Utama</th>
              <th scope="col" class="py-3.5 px-5 font-bold">Kondisi / Status</th>
              <th scope="col" class="py-3.5 px-5 font-bold">Potensi Penghematan</th>
              <th scope="col" class="py-3.5 px-5 font-bold">Rekomendasi Efisiensi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-100">
            {hasilAuditList.map((item) => (
              <tr class="hover:bg-neutral-50/80 transition-colors">
                <td class="py-4 px-5 font-semibold text-primary-900 whitespace-nowrap">
                  {item.areaPemeriksaan}
                </td>
                <td class="py-4 px-5 text-neutral-600">
                  {item.peralatanUtama}
                </td>
                <td class="py-4 px-5 text-neutral-700 font-medium">
                  {item.kondisiLampu}
                </td>
                <td class="py-4 px-5 font-semibold text-emerald-700 whitespace-nowrap">
                  {item.potensiPenghematan}
                </td>
                <td class="py-4 px-5 text-neutral-600 leading-relaxed max-w-xs">
                  {item.rekomendasi}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- REKOMENDASI HEMAT ENERGI -->
    <div class="bg-primary-50/70 rounded-2xl border border-primary-200/60 p-6 md:p-8" data-reveal>
      <h3 class="text-lg font-bold text-primary-900 mb-4 flex items-center gap-2">
        <svg viewBox="0 0 24 24" class="w-5 h-5 text-primary-700" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        <span>Langkah Rekomendasi Konservasi Energi Sekolah</span>
      </h3>
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-3">
        {rekomendasiUmum.map((poin) => (
          <li class="flex items-start gap-2.5 text-sm leading-relaxed text-neutral-700">
            <svg viewBox="0 0 24 24" class="w-4 h-4 shrink-0 text-emerald-600 mt-1" fill="none" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7" />
            </svg>
            <span>{poin}</span>
          </li>
        ))}
      </ul>
    </div>

  </div>
</section>