---
import SectionHeading from "../ui/SectionHeading.astro";
import { arsitekturSampahData } from "../../data/arsitekturSampah";
---

<!-- ID DISESUAIKAN SAMA NAVBAR (#sampah) -->
<section id="sampah" class="bg-white py-16 md:py-20 border-t border-neutral-100">
  <div class="container-site max-w-6xl mx-auto px-4 space-y-10">
    
    <!-- HEADER SEKSI -->
    <SectionHeading
      eyebrow="Arsitektur Perilaku Sekolah"
      title={arsitekturSampahData.judul}
      subtitle={arsitekturSampahData.subjudul}
    />

    <!-- CONTAINER UTAMA -->
    <div class="bg-neutral-50/80 rounded-2xl border border-neutral-200/80 p-6 md:p-8 shadow-sm space-y-6" data-reveal>
      
      <!-- GRID GAMBAR & NARASI DESKRIPSI -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
        
        <!-- KOLOM GAMBAR (HOVER ZOOM & FLOATING HIJAU) -->
        <div class="lg:col-span-5 flex flex-col justify-between overflow-hidden rounded-xl border border-neutral-200/80 bg-white p-2 shadow-sm group">
          <div class="w-full flex-1 flex items-center justify-center overflow-hidden rounded-lg bg-neutral-100/80 p-2 relative">
            <img
              src={arsitekturSampahData.gambarUtama.src}
              alt={arsitekturSampahData.gambarUtama.alt}
              loading="lazy"
              class="w-full h-auto max-h-[350px] object-cover mx-auto rounded-md transition-transform duration-500 group-hover:scale-105 cursor-pointer"
              id="triggerSampahImg"
            />
            <!-- FLOATING BUTTON HOVER HIJAU -->
            <div class="absolute bottom-3 right-3 z-10">
              <button
                type="button"
                id="openSampahModal"
                class="inline-flex items-center gap-1.5 text-xs font-semibold text-neutral-700 bg-white border border-neutral-300 px-3 py-1.5 rounded-full shadow-md transition-all duration-300 cursor-pointer group-hover:bg-emerald-600 group-hover:text-white group-hover:border-emerald-600"
              >
                <svg viewBox="0 0 24 24" class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607zM10.5 7.5v6m3-3h-6" />
                </svg>
                <span>Perbesar Desain</span>
              </button>
            </div>
          </div>
          
          <div class="p-3 bg-white rounded-lg mt-2 border border-neutral-100 text-center">
            <p class="text-xs text-neutral-600 font-medium leading-relaxed">
              {arsitekturSampahData.gambarUtama.caption}
            </p>
          </div>
        </div>

        <!-- KOLOM NARASI & FITUR -->
        <div class="lg:col-span-7 flex flex-col justify-between space-y-6">
          <div class="space-y-4 text-sm md:text-base text-neutral-700 leading-relaxed">
            <h3 class="text-lg font-bold text-emerald-950">
              Pendekatan Tata Ruang & Media Visual
            </h3>
            {arsitekturSampahData.deskripsi.map((paragraf) => (
              <p>{paragraf}</p>
            ))}
          </div>

          <!-- GRID FITUR / LUARAN DESAIN -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
            {arsitekturSampahData.fiturUtama.map((fitur) => (
              <div class="p-3.5 bg-white rounded-xl border border-neutral-200/80 shadow-2xs space-y-0.5">
                <h4 class="text-xs font-bold text-emerald-900 flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-emerald-500 shrink-0"></span>
                  {fitur.judul}
                </h4>
                <p class="text-xs text-neutral-600 leading-relaxed pl-3.5">
                  {fitur.deskripsi}
                </p>
              </div>
            ))}
          </div>
          
        </div>

      </div>
    </div>

  </div>
</section>

<!-- LIGHTBOX MODAL (DENGAN TOMBOL UNDUH, TANPA BINGKAI PUTIH & DENGAN CAPTION) -->
<div
  id="sampahModal"
  class="fixed inset-0 z-50 hidden bg-black/90 backdrop-blur-md flex flex-col items-center justify-center p-4 md:p-6 transition-all duration-300 select-none"
>
  <!-- KELOMPOK TOMBOL POJOK KANAN ATAS (UNDUH & SILANG CLOSE) -->
  <div class="fixed top-4 right-4 md:top-6 md:right-6 z-50 flex items-center gap-3">
    <!-- 📥 TOMBOL UNDUH GAMBAR -->
    <a
      href={arsitekturSampahData.gambarUtama.src}
      download="Desain-Arsitektur-Perilaku-Pengelolaan-Sampah.jpg"
      class="p-3 rounded-full bg-white/10 hover:bg-emerald-600 text-white transition-all duration-200 focus:outline-none cursor-pointer border border-white/20 shadow-lg flex items-center justify-center"
      title="Unduh Desain Gambar"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
      </svg>
    </a>

    <!-- ✖ TOMBOL SILANG CLOSE -->
    <button
      type="button"
      id="closeSampahModal"
      class="p-3 rounded-full bg-white/10 hover:bg-white/20 text-white transition-all duration-200 focus:outline-none cursor-pointer border border-white/20 shadow-lg"
      aria-label="Tutup Modal"
    >
      <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <div class="relative w-full h-full max-w-6xl max-h-[85vh] flex flex-col items-center justify-center p-2">
    <!-- GAMBAR MODAL TANPA BINGKAI PUTIH -->
    <img
      src={arsitekturSampahData.gambarUtama.src}
      alt={arsitekturSampahData.gambarUtama.alt}
      class="max-w-full max-h-[80vh] object-contain mx-auto rounded-lg shadow-2xl"
    />

    <!-- CAPTION DI DALAM MODAL -->
    <p class="text-white text-xs md:text-sm font-medium mt-3 text-center bg-black/50 px-4 py-2 rounded-full border border-white/10 max-w-2xl">
      {arsitekturSampahData.gambarUtama.caption}
    </p>
  </div>
</div>

<script>
  const openBtn = document.getElementById("openSampahModal");
  const triggerImg = document.getElementById("triggerSampahImg");
  const closeBtn = document.getElementById("closeSampahModal");
  const modal = document.getElementById("sampahModal");

  function openModal() {
    modal?.classList.remove("hidden");
    document.body.style.overflow = "hidden";
  }

  function closeModal() {
    modal?.classList.add("hidden");
    document.body.style.overflow = "";
  }

  openBtn?.addEventListener("click", openModal);
  triggerImg?.addEventListener("click", openModal);
  closeBtn?.addEventListener("click", closeModal);

  modal?.addEventListener("click", (e) => {
    if (e.target === modal) closeModal();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !modal?.classList.contains("hidden")) closeModal();
  });
</script>