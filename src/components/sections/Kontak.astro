---
import SectionHeading from "../ui/SectionHeading.astro";
import { socialLinks } from "../../data/links";
import { siteConfig } from "../../data/site.config";

const { lokasi } = siteConfig.contact;
const { tiktok, email, instagram } = socialLinks;
---

<section id="kontak" class="bg-white">
  <div class="container-site section-spacing">
    <SectionHeading
      title="Hubungi Kami"
      subtitle="Ada pertanyaan seputar program atau ingin berkolaborasi? Silakan hubungi tim KKN-T 141 Desa Batursari."
      align="center"
      class="mx-auto"
    />

    <!-- KARTU KONTAK (REVISI: HIJAU MUDA GRADIENT MODERN MATCH DENGAN STRUKTUR DESA) -->
    <div class="max-w-xl mx-auto rounded-2xl bg-gradient-to-br from-emerald-100/90 via-emerald-50 to-teal-50 text-emerald-950 border border-emerald-300/80 p-8 md:p-10 text-center shadow-sm space-y-6 backdrop-blur-sm" data-reveal>
      
      <!-- ALAMAT LOKASI -->
      <p class="text-base font-semibold text-emerald-950 leading-relaxed">
        <i class="fas fa-map-marker-alt text-amber-500 mr-2 text-lg"></i>{lokasi}
      </p>

      <!-- TOMBOL SOSIAL MEDIA & EMAIL -->
      <div class="flex flex-wrap items-center justify-center gap-4 pt-1">
        {tiktok && (
          <a
            href={tiktok}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full font-heading font-semibold text-base px-6 py-3 bg-black text-white hover:scale-105 transition-transform duration-200 shadow-md group"
          >
            <i class="fab fa-tiktok text-white text-lg"></i>
            TikTok
          </a>
        )}
        
        {email && (
          <a
            href={email}
            class="inline-flex items-center gap-2 rounded-full font-heading font-semibold text-base px-6 py-3 bg-red-600 text-white hover:scale-105 transition-transform duration-200 shadow-md group"
          >
            <i class="fas fa-at text-white"></i>
            Kirim Email
          </a>
        )}

        {instagram && (
          <a
            href={instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full font-heading font-semibold text-base px-6 py-3 bg-gradient-to-r from-purple-600 via-pink-600 to-amber-500 text-white hover:scale-105 transition-transform duration-200 shadow-md group"
          >
            <i class="fab fa-instagram text-white text-lg"></i>
            Instagram
          </a>
        )}
      </div>
    </div>
  </div>
</section>
