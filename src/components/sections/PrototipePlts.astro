---
import SectionHeading from "../ui/SectionHeading.astro";

// Data Gambar untuk Auto-Slider PLTSa
const fotoDokumentasi = [
  {
    src: "/images/prototipe-pltsa-alat.jpg",
    alt: "Prototipe Alat Pembangkit Listrik Tenaga Sampah (PLTSa)",
    caption: "Prototipe Alat Pembangkit Listrik Tenaga Sampah (PLTSa).",
  },
  {
    src: "/images/prototipe-pltsa.jpg",
    alt: "Sosialisasi Prototipe PLTSa di SMP Negeri 3 Mranggen",
    caption: "Sosialisasi & pemaparan prototipe PLTSa bersama siswa/siswi SMPN 3 Mranggen.",
  },
];

// Data Gambar Diagram Skematik PLTSa
const diagramPltsa = {
  src: "/images/PLTSa.jpg",
  alt: "Diagram Skematik Alur Kerja Pembangkit Listrik Tenaga Sampah (PLTSa)",
};

// Tahapan Alur Konversi Berdasarkan Nomor di Diagram
const langkahKonversi = [
  { nomor: "1 & 2", judul: "Penerimaan & Penampungan Sampah", deskripsi: "Truk menimbang dan membuang sampah ke penampungan (Refuse Storage Pit) untuk diangkat pengeruk (Crane) ke ruang pembakaran." },
  { nomor: "3", judul: "Insinerasi (Pembakaran)", deskripsi: "Proses pembakaran sampah suhu tinggi di dalam Furnace untuk menghasilkan gas panas bertemperatur tinggi." },
  { nomor: "4", judul: "Ketel Uap (Boiler)", deskripsi: "Panas pembakaran digunakan untuk mendidihkan air pada Boiler hingga menghasilkan uap air (Steam) bertekanan tinggi." },
  { nomor: "5", judul: "Turbin Uap & Generator", deskripsi: "Uap bertekanan menggerakkan Steam Turbine yang terhubung ke Generator untuk menghasilkan energi listrik terbarukan." },
  { nomor: "6 & 7", judul: "Pengolahan Residu & Abu", deskripsi: "Abu sisa pembakaran (Ash) diolah bersama campuran semen/air untuk dimanfaatkan kembali sebagai material beton/landfill." },
  { nomor: "Stack", judul: "Pembersihan Gas Buang", deskripsi: "Gas buang disaring menggunakan Bag House & sistem filter emisi sebelum dilepas secara aman melalui cerobong (Stack)." },
];

const linkReportasePltsa = "https://link-reportase-pltsa-kamu.com";
---

<section id="pltsa" class="bg-white py-16 md:py-20 border-t border-neutral-100">
  <div class="container-site max-w-6xl mx-auto px-4">
    
    <!-- HEADER SEKSI -->
    <SectionHeading
      eyebrow="Sosialisasi Edukasi EBT"
      title="Sosialisasi Prototipe Pembangkit Listrik Tenaga Sampah (PLTSa)"
      subtitle="Program edukasi dan pengenalan konsep kerja Pembangkit Listrik Tenaga Sampah (PLTSa) untuk memberikan pemahaman kepada siswa mengenai proses konversi sampah menjadi energi listrik terbarukan."
    />

    <!-- 1. DOKUMENTASI KEGIATAN (AUTO-SLIDE CAROUSEL) & PENJELASAN -->
    <div class="bg-neutral-50/80 rounded-2xl border border-neutral-200/80 p-6 md:p-8 mt-10 mb-8 shadow-sm" data-reveal>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
        
        <!-- KOLOM KIRI: AUTO-SLIDE CAROUSEL GAMBAR -->
        <div class="lg:col-span-5 flex flex-col justify-between overflow-hidden rounded-xl border border-neutral-200/80 bg-white p-3 shadow-sm relative group">
          
          <!-- CONTAINER CAROUSEL SLIDES -->
          <div id="pltsaCarousel" class="relative w-full h-[280px] md:h-[320px] overflow-hidden rounded-lg bg-neutral-100">
            {fotoDokumentasi.map((foto, index) => (
              <div
                class={`pltsa-slide absolute inset-0 w-full h-full transition-opacity duration-700 ease-in-out ${index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'}`}
                data-slide-index={index}
              >
                <img
                  src={foto.src}
                  alt={foto.alt}
                  loading="lazy"
                  class="w-full h-full object-cover rounded-lg"
                />
              </div>
            ))}

            <!-- TOMBOL NAVIGASI PREV/NEXT (MUNCUL SAAT HOVER) -->
            <button
              type="button"
              id="prevPltsaSlide"
              class="absolute left-2 top-1/2 -translate-y-1/2 z-20 p-2 rounded-full bg-black/40 text-white hover:bg-black/60 transition-all opacity-0 group-hover:opacity-100 cursor-pointer"
              aria-label="Previous Slide"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
            </button>
            <button
              type="button"
              id="nextPltsaSlide"
              class="absolute right-2 top-1/2 -translate-y-1/2 z-20 p-2 rounded-full bg-black/40 text-white hover:bg-black/60 transition-all opacity-0 group-hover:opacity-100 cursor-pointer"
              aria-label="Next Slide"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
            </button>
          </div>

          <!-- CAPTION & INDIKATOR DOTS -->
          <div class="mt-3 p-2 bg-white rounded-lg border border-neutral-100 text-center space-y-2">
            <p id="pltsaCaption" class="text-xs md:text-sm text-neutral-600 font-medium leading-relaxed min-h-[38px] flex items-center justify-center">
              {fotoDokumentasi[0].caption}
            </p>
            
            <!-- DOTS INDICATOR -->
            <div class="flex items-center justify-center gap-1.5 pt-1">
              {fotoDokumentasi.map((_, idx) => (
                <button
                  type="button"
                  class={`pltsa-dot w-2.5 h-2.5 rounded-full transition-all cursor-pointer ${idx === 0 ? 'bg-primary-700 w-5' : 'bg-neutral-300'}`}
                  data-dot-index={idx}
                  aria-label={`Go to slide ${idx + 1}`}
                />
              ))}
            </div>
          </div>

        </div>

        <!-- KOLOM KANAN: PENJELASAN SOSIALISASI & LINK REPORTASE -->
        <div class="lg:col-span-7 flex flex-col justify-between space-y-6">
          <div class="space-y-4 text-sm md:text-base text-neutral-700 leading-relaxed">
            <h3 class="text-lg font-bold text-primary-900">
              Pelaksanaan Sosialisasi & Pengenalan Alat
            </h3>
            <p>
              Melalui kegiatan sosialisasi prototipe PLTSa ini, para siswa diajak untuk memahami pentingnya pengelolaan sampah berbasis 3R serta prinsip kelestarian lingkungan di sekolah.
            </p>
            <p>
              Program ini memberikan edukasi serta penjelasan mengenai mekanisme teknis bagaimana limbah sampah dapat dikonversi menjadi sumber energi listrik terbarukan, sekaligus memantik kepedulian lingkungan dan minat inovasi teknologi sejak dini.
            </p>
          </div>


        </div>

      </div>
    </div>

    <!-- 2. DIAGRAM SKEMATIK KONVERSI PLTSa -->
    <div class="bg-neutral-50/80 rounded-2xl border border-neutral-200/80 p-6 md:p-8 space-y-6 shadow-sm mb-8" data-reveal>
      <div class="border-b border-neutral-200/60 pb-4">
        <h3 class="text-lg font-bold text-primary-900">
          Skema & Alur Kerja Konversi Termal PLTSa
        </h3>
        <p class="text-xs md:text-sm text-neutral-600">
          Diagram teknis proses pengolahan sampah hingga menjadi energi listrik yang dijelaskan kepada siswa.
        </p>
      </div>

      <!-- CONTAINER GAMBAR SKEMA DENGAN TOMBOL FLOATING IN-IMAGE -->
      <div class="rounded-xl overflow-hidden border border-neutral-200 bg-white p-2 md:p-4 shadow-xs relative">
        <img
          src={diagramPltsa.src}
          alt={diagramPltsa.alt}
          loading="lazy"
          class="w-full h-auto object-contain mx-auto max-h-[500px] cursor-pointer"
          id="triggerPltsaImg"
        />

        <div class="mt-3 md:mt-0 md:absolute md:bottom-4 md:right-4 flex justify-end">
          <button
            type="button"
            id="openPltsaModal"
            class="inline-flex items-center gap-1.5 text-xs font-semibold text-neutral-700 hover:text-primary-800 bg-white border border-neutral-300 hover:border-primary-400 px-3.5 py-2 rounded-xl shadow-md transition-all cursor-pointer hover:shadow-lg"
          >
            <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607zM10.5 7.5v6m3-3h-6" />
            </svg>
            <span>Perbesar Skema</span>
          </button>
        </div>
      </div>

      <!-- GRID RANGKUMAN PENJELASAN NOMOR SKEMA (1-7) -->
      <div class="pt-4 space-y-3">
        <h4 class="text-sm font-bold text-neutral-800">
          Penjelasan Tahapan Konversi Energi:
        </h4>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {langkahKonversi.map((item) => (
            <div class="p-4 bg-white rounded-xl border border-neutral-200/70 shadow-2xs space-y-1">
              <span class="inline-block px-2 py-0.5 bg-primary-100 text-primary-900 text-xs font-bold rounded-md">
                Tahap {item.nomor}
              </span>
              <h5 class="text-sm font-bold text-neutral-900">{item.judul}</h5>
              <p class="text-xs text-neutral-600 leading-relaxed">{item.deskripsi}</p>
            </div>
          ))}
        </div>
      </div>
    </div>

  </div>
</section>

<!-- LIGHTBOX MODAL UNTUK PERBESAR SKEMA PLTSa -->
<div
  id="pltsaModal"
  class="fixed inset-0 z-50 hidden bg-black/90 backdrop-blur-md flex flex-col items-center justify-center p-4 md:p-6 transition-all duration-300"
>
  <button
    type="button"
    id="closePltsaModal"
    class="fixed top-4 right-4 md:top-6 md:right-6 z-50 p-3 rounded-full bg-white/10 hover:bg-white/20 text-white transition-all duration-200 focus:outline-none cursor-pointer border border-white/20 shadow-lg"
    aria-label="Tutup Skema"
  >
    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>

  <div class="relative w-full h-full max-w-6xl max-h-[92vh] flex items-center justify-center overflow-auto p-2">
    <img
      src={diagramPltsa.src}
      alt={diagramPltsa.alt}
      class="max-w-full max-h-full object-contain mx-auto rounded-lg shadow-2xl bg-white p-2"
    />
  </div>
</div>

<!-- SCRIPT SLIDER AUTOSLIDE & MODAL -->
<script is:inline define:vars={{ fotoDokumentasi }}>
  // === LOGIKA AUTO-SLIDE CAROUSEL ===
  let currentSlide = 0;
  const slides = document.querySelectorAll('.pltsa-slide');
  const dots = document.querySelectorAll('.pltsa-dot');
  const captionEl = document.getElementById('pltsaCaption');
  const prevBtn = document.getElementById('prevPltsaSlide');
  const nextBtn = document.getElementById('nextPltsaSlide');
  let autoSlideTimer;

  function goToSlide(index) {
    slides.forEach((slide, idx) => {
      if (idx === index) {
        slide.classList.remove('opacity-0', 'z-0');
        slide.classList.add('opacity-100', 'z-10');
      } else {
        slide.classList.remove('opacity-100', 'z-10');
        slide.classList.add('opacity-0', 'z-0');
      }
    });

    dots.forEach((dot, idx) => {
      if (idx === index) {
        dot.classList.remove('bg-neutral-300');
        dot.classList.add('bg-primary-700', 'w-5');
      } else {
        dot.classList.remove('bg-primary-700', 'w-5');
        dot.classList.add('bg-neutral-300');
      }
    });

    if (captionEl && fotoDokumentasi[index]) {
      captionEl.textContent = fotoDokumentasi[index].caption;
    }

    currentSlide = index;
  }

  function startAutoSlide() {
    stopAutoSlide();
    autoSlideTimer = setInterval(() => {
      const nextIndex = (currentSlide + 1) % slides.length;
      goToSlide(nextIndex);
    }, 3500); // Berganti otomatis setiap 3.5 detik
  }

  function stopAutoSlide() {
    if (autoSlideTimer) clearInterval(autoSlideTimer);
  }

  prevBtn?.addEventListener('click', () => {
    const prevIndex = (currentSlide - 1 + slides.length) % slides.length;
    goToSlide(prevIndex);
    startAutoSlide();
  });

  nextBtn?.addEventListener('click', () => {
    const nextIndex = (currentSlide + 1) % slides.length;
    goToSlide(nextIndex);
    startAutoSlide();
  });

  dots.forEach((dot) => {
    dot.addEventListener('click', (e) => {
      const idx = parseInt(e.target.getAttribute('data-dot-index') || '0', 10);
      goToSlide(idx);
      startAutoSlide();
    });
  });

  // Mulai autoslide saat komponen dimuat
  if (slides.length > 0) {
    startAutoSlide();
  }

  // Hentikan autoslide saat mouse diarahkan ke gambar
  const carouselEl = document.getElementById('pltsaCarousel');
  carouselEl?.addEventListener('mouseenter', stopAutoSlide);
  carouselEl?.addEventListener('mouseleave', startAutoSlide);

  // === LOGIKA LIGHTBOX MODAL ===
  const openPltsaBtn = document.getElementById("openPltsaModal");
  const triggerPltsaImg = document.getElementById("triggerPltsaImg");
  const closePltsaBtn = document.getElementById("closePltsaModal");
  const pltsaModal = document.getElementById("pltsaModal");

  function openModal() {
    pltsaModal?.classList.remove("hidden");
    document.body.style.overflow = "hidden";
  }

  function closeModal() {
    pltsaModal?.classList.add("hidden");
    document.body.style.overflow = "";
  }

  openPltsaBtn?.addEventListener("click", openModal);
  triggerPltsaImg?.addEventListener("click", openModal);
  closePltsaBtn?.addEventListener("click", closeModal);

  pltsaModal?.addEventListener("click", (e) => {
    if (e.target === pltsaModal) closeModal();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !pltsaModal?.classList.contains("hidden")) closeModal();
  });
</script>