---
import SectionHeading from "../ui/SectionHeading.astro";
import {
  petaPotensi,
  deskripsiPotensi,
  penjelasanPeta,
  linkReportase,
} from "../../data/potensiBiogas";
---

<section id="potensi" class="bg-white py-16 md:py-20 border-t border-neutral-100">
  <div class="container-site max-w-6xl mx-auto px-4">
    <!-- HEADER SEKSI -->
    <SectionHeading
      eyebrow="Program EBT Biogas"
      title="Pemetaan Potensi Biogas Desa Batursari"
      subtitle={deskripsiPotensi}
    />

    <!-- PETA HASIL SURVEI & PEMETAAN -->
    <div 
      class="group relative rounded-2xl overflow-hidden border border-neutral-200/80 shadow-sm mb-8 bg-neutral-50 p-2 md:p-4 cursor-pointer" 
      id="mapContainer"
      data-reveal
    >
      <!-- WADAH GAMBAR DENGAN OVERFLOW HIDDEN -->
      <div class="overflow-hidden rounded-xl bg-white shadow-inner">
        <img
          src={petaPotensi.src}
          alt={petaPotensi.alt}
          width="1000"
          height="1400"
          loading="lazy"
          class="w-full h-auto object-contain mx-auto max-h-[850px] bg-white transition-transform duration-500 ease-out group-hover:scale-105"
          id="triggerMapImg"
        />
      </div>

      <!-- FLOATING BUTTON PERBESAR -->
      <div class="absolute bottom-4 right-4 md:bottom-6 md:right-6 z-10">
        <button
          type="button"
          id="openMapModal"
          class="inline-flex items-center gap-2 text-xs md:text-sm font-semibold text-neutral-700 bg-white border border-neutral-300 px-4 py-2.5 rounded-full shadow-md transition-all duration-300 cursor-pointer group-hover:bg-emerald-600 group-hover:text-white group-hover:border-emerald-600 group-hover:shadow-xl group-hover:scale-105"
        >
          <svg viewBox="0 0 24 24" class="w-4 h-4 text-neutral-600 transition-colors duration-300 group-hover:text-white group-hover:scale-110" fill="none" stroke="currentColor" stroke-width="2.2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607zM10.5 7.5v6m3-3h-6" />
          </svg>
          <span>Klik untuk memperbesar</span>
        </button>
      </div>
    </div>

    <!-- NARASI PENJELASAN PETA & TOMBOL REPORTASE -->
    <div class="bg-neutral-50/80 rounded-2xl border border-neutral-200/80 p-6 md:p-8 space-y-4" data-reveal>
      <h3 class="text-lg font-bold text-emerald-950">
        Ringkasan Hasil Pemetaan Spasial SIG
      </h3>
      
      {penjelasanPeta.map((paragraf) => (
        <p class="text-sm md:text-base text-neutral-700 leading-relaxed">
          {paragraf}
        </p>
      ))}

      <!-- CTA LINK REPORTASE -->
      <div class="pt-4 border-t border-neutral-200/60 flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-2 text-xs md:text-sm text-neutral-600 font-medium">
          <svg class="w-5 h-5 text-emerald-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
          </svg>
          <span>Ingin membaca pembahasan pemetaan lengkap program ini?</span>
        </div>

        <a
          href={linkReportase}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm font-semibold text-emerald-900 bg-emerald-100/80 hover:bg-emerald-200/80 px-4 py-2 rounded-xl transition-all duration-200 cursor-pointer shrink-0 shadow-2xs"
        >
          <span>Baca Artikel Reportase Lengkap</span>
          <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- LIGHTBOX MODAL (LENGKAP DENGAN TOMBOL UNDUH) -->
<div
  id="mapModal"
  class="fixed inset-0 z-50 hidden bg-black/90 backdrop-blur-md flex flex-col items-center justify-center p-4 md:p-6 transition-all duration-300 select-none"
>
  <!-- KELOMPOK TOMBOL AKSES POJOK KANAN ATAS (UNDUH & CLOSE) -->
  <div class="fixed top-4 right-4 md:top-6 md:right-6 z-50 flex items-center gap-3">
    <!-- 📥 TOMBOL UNDUH PETA -->
    <a
      href={petaPotensi.src}
      download="Peta-Potensi-Biogas-Desa-Batursari.jpg"
      class="p-3 rounded-full bg-white/10 hover:bg-emerald-600 text-white transition-all duration-200 focus:outline-none cursor-pointer border border-white/20 shadow-lg flex items-center justify-center"
      title="Unduh Peta Potensi Biogas"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
      </svg>
    </a>

    <!-- ✖ TOMBOL SILANG CLOSE -->
    <button
      type="button"
      id="closeMapModal"
      class="p-3 rounded-full bg-white/10 hover:bg-white/20 text-white transition-all duration-200 focus:outline-none cursor-pointer border border-white/20 shadow-lg"
      aria-label="Tutup Peta"
    >
      <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <div class="relative w-full h-full max-w-6xl max-h-[92vh] flex items-center justify-center overflow-auto p-2">
    <img
      src={petaPotensi.src}
      alt={petaPotensi.alt}
      class="max-w-full max-h-full object-contain mx-auto rounded-lg shadow-2xl bg-white"
    />
  </div>
</div>

<!-- SCRIPT UNTUK BUKA/TUTUP MODAL -->
<script>
  const mapContainer = document.getElementById("mapContainer");
  const openBtn = document.getElementById("openMapModal");
  const closeBtn = document.getElementById("closeMapModal");
  const modal = document.getElementById("mapModal");

  function openModal() {
    modal?.classList.remove("hidden");
    document.body.style.overflow = "hidden";
  }

  function closeModal() {
    modal?.classList.add("hidden");
    document.body.style.overflow = "";
  }

  mapContainer?.addEventListener("click", openModal);
  openBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    openModal();
  });
  closeBtn?.addEventListener("click", closeModal);

  modal?.addEventListener("click", (e) => {
    if (e.target === modal) {
      closeModal();
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !modal?.classList.contains("hidden")) {
      closeModal();
    }
  });
</script>