---
import SectionHeading from "../ui/SectionHeading.astro";
import {
  petaPotensi,
  deskripsiPotensi,
  penjelasanPeta,
  linkReportase,
} from "../../data/potensiBiogas";
---

<section id="potensi" class="bg-white py-16 md:py-20 border-t border-neutral-100">
  <div class="container-site max-w-6xl mx-auto px-4">
    <!-- HEADER SEKSI -->
    <SectionHeading
      eyebrow="Program EBT Biogas"
      title="Pemetaan Potensi Biogas Desa Batursari"
      subtitle={deskripsiPotensi}
    />

    <!-- PETA HASIL SURVEI & PEMETAAN -->
    <div class="rounded-2xl overflow-hidden border border-neutral-200/80 shadow-sm mb-8 bg-neutral-50 p-2 md:p-4 relative" data-reveal>
      <img
        src={petaPotensi.src}
        alt={petaPotensi.alt}
        width="1000"
        height="1400"
        loading="lazy"
        class="w-full h-auto object-contain mx-auto max-h-[850px] bg-white rounded-xl shadow-inner cursor-pointer"
        id="triggerMapImg"
      />
      <!-- TOMBOL POPUP MODAL -->
      <div class="mt-3 flex justify-end px-2">
        <button
          type="button"
          id="openMapModal"
          class="inline-flex items-center gap-1.5 text-xs font-semibold text-neutral-700 hover:text-primary-800 bg-white border border-neutral-300 hover:border-primary-400 px-3 py-2 rounded-xl shadow-sm transition-all cursor-pointer"
        >
          <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607zM10.5 7.5v6m3-3h-6" />
          </svg>
          <span>Perbesar Peta</span>
        </button>
      </div>
    </div>

    <!-- NARASI PENJELASAN PETA & TOMBOL REPORTASE -->
    <div class="bg-neutral-50/80 rounded-2xl border border-neutral-200/80 p-6 md:p-8 space-y-4" data-reveal>
      <h3 class="text-lg font-bold text-primary-900">
        Ringkasan Hasil Pemetaan Potensi Biogas
      </h3>
      
      {penjelasanPeta.map((paragraf) => (
        <p class="text-sm md:text-base text-neutral-700 leading-relaxed">
          {paragraf}
        </p>
      ))}

      <!-- CTA LINK REPORTASE -->
      <div class="pt-4 border-t border-neutral-200/60 flex flex-wrap items-center justify-between gap-4">
        <span class="text-xs text-neutral-500 font-medium">
          📄 Ingin membaca pembahasan lengkap program ini?
        </span>
        <a
          href={linkReportase}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm font-semibold text-primary-800 hover:text-primary-950 bg-primary-100/80 hover:bg-primary-200/80 px-4 py-2 rounded-xl transition-all"
        >
          <span>Baca Artikel Reportase Lengkap</span>
          <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- LIGHTBOX MODAL (CLEAN & MAXIMUM SIZE WITHOUT WHITE BOX) -->
<div
  id="mapModal"
  class="fixed inset-0 z-50 hidden bg-black/90 backdrop-blur-md flex flex-col items-center justify-center p-4 md:p-6 transition-all duration-300"
>
  <!-- TOMBOL SILANG FLOATING DI POJOK KANAN ATAS -->
  <button
    type="button"
    id="closeMapModal"
    class="fixed top-4 right-4 md:top-6 md:right-6 z-50 p-3 rounded-full bg-white/10 hover:bg-white/20 text-white transition-all duration-200 focus:outline-none cursor-pointer border border-white/20 shadow-lg"
    aria-label="Tutup Peta"
  >
    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>

  <!-- WADAH GAMBAR LEGA TANPA BORDER PUTIH -->
  <div class="relative w-full h-full max-w-6xl max-h-[92vh] flex items-center justify-center overflow-auto p-2">
    <img
      src={petaPotensi.src}
      alt={petaPotensi.alt}
      class="max-w-full max-h-full object-contain mx-auto rounded-lg shadow-2xl bg-white"
    />
  </div>
</div>

<!-- SCRIPT UNTUK BUKA/TUTUP MODAL -->
<script>
  const openBtn = document.getElementById("openMapModal");
  const triggerImg = document.getElementById("triggerMapImg");
  const closeBtn = document.getElementById("closeMapModal");
  const modal = document.getElementById("mapModal");

  function openModal() {
    modal?.classList.remove("hidden");
    document.body.style.overflow = "hidden"; // Cegah scroll latar belakang
  }

  function closeModal() {
    modal?.classList.add("hidden");
    document.body.style.overflow = ""; // Kembalikan scroll
  }

  openBtn?.addEventListener("click", openModal);
  triggerImg?.addEventListener("click", openModal);
  closeBtn?.addEventListener("click", closeModal);

  // Klik area hitam di luar gambar untuk menutup modal
  modal?.addEventListener("click", (e) => {
    if (e.target === modal) {
      closeModal();
    }
  });

  // Tekan tombol ESC untuk menutup
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !modal?.classList.contains("hidden")) {
      closeModal();
    }
  });
</script>