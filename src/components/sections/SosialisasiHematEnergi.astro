---
import SectionHeading from "../ui/SectionHeading.astro";
import { sosialisasiHematEnergiData } from "../../data/sosialisasiHematEnergi";
---

<section id="sosialisasi-hemat-energi" class="bg-neutral-50 py-16 md:py-20 border-t border-neutral-200">
  <div class="container-site max-w-5xl mx-auto px-4 space-y-10">
    
    <SectionHeading
      eyebrow="Edukasi Transisi Hijau Sekolah"
      title={sosialisasiHematEnergiData.judul}
      subtitle={sosialisasiHematEnergiData.subjudul}
    />

    <div class="bg-white rounded-2xl border border-neutral-200 p-6 md:p-8 shadow-sm space-y-8" data-reveal>
      
      <div class="w-full max-w-4xl mx-auto rounded-xl border border-neutral-200/80 bg-neutral-100 p-3 shadow-sm group">
        <div class="w-full rounded-lg bg-white p-2 relative overflow-hidden flex flex-col items-center">
          
          <div class="w-full flex items-center justify-center relative max-h-[500px] overflow-hidden rounded-md cursor-pointer" id="triggerTransisiImg">
            <img
              src={sosialisasiHematEnergiData.gambar}
              alt={sosialisasiHematEnergiData.judul}
              loading="lazy"
              class="w-full h-auto max-h-[480px] object-contain mx-auto rounded-md transition-transform duration-500 ease-out group-hover:scale-105"
            />

            <div class="absolute bottom-3 right-3 z-20">
              <button
                type="button"
                id="openTransisiModalBtn"
                class="inline-flex items-center gap-1.5 text-xs font-semibold text-neutral-700 bg-white/95 backdrop-blur-xs border border-neutral-300 px-3.5 py-1.5 rounded-full shadow-md transition-all duration-300 cursor-pointer hover:bg-emerald-600 hover:text-white hover:border-emerald-600"
              >
                <svg viewBox="0 0 24 24" class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607zM10.5 7.5v6m3-3h-6" />
                </svg>
                <span>Perbesar Foto</span>
              </button>
            </div>
          </div>

          <div class="p-2.5 bg-neutral-50 rounded-lg mt-3 border border-neutral-100 text-center w-full z-10">
            <p class="text-xs md:text-sm text-neutral-600 font-medium leading-relaxed">
              {sosialisasiHematEnergiData.caption}
            </p>
          </div>

        </div>
      </div>

      <div class="space-y-6 pt-2 border-t border-neutral-200/60 max-w-4xl mx-auto">
        <div class="space-y-3 text-sm md:text-base text-neutral-700 leading-relaxed">
          {sosialisasiHematEnergiData.deskripsi.map((paragraf) => (
            <p>{paragraf}</p>
          ))}
        </div>

        <div class="pt-4 border-t border-neutral-200/60 flex flex-wrap items-center justify-between gap-4">
          <div class="flex items-center gap-2 text-xs md:text-sm text-neutral-700">
            <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
            </svg>
            <span class="text-neutral-800">Baca liputan media berita JatengVox mengenai kegiatan ini secara lengkap:</span>
          </div>

          <a
            href={sosialisasiHematEnergiData.newsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-sm text-emerald-900 bg-emerald-100 hover:bg-emerald-200 px-5 py-2.5 rounded-xl transition-all duration-200 cursor-pointer shrink-0 border border-emerald-300 shadow-2xs font-bold"
          >
            <span>Baca di JatengVox</span>
            <svg class="w-4 h-4 text-emerald-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
            </svg>
          </a>
        </div>
      </div>

    </div>

  </div>
</section>

<div
  id="transisiModal"
  class="fixed inset-0 z-50 hidden bg-black/90 backdrop-blur-md flex flex-col items-center justify-center p-4 md:p-6 transition-all duration-300 select-none"
>
  <div class="fixed top-4 right-4 md:top-6 md:right-6 z-50 flex items-center gap-3">
    <a
      href={sosialisasiHematEnergiData.gambar}
      download="Sosialisasi-Transisi-Hijau-SMPN3-Mranggen.jpg"
      class="p-3 rounded-full bg-white/10 hover:bg-emerald-600 text-white transition-all duration-200 focus:outline-none cursor-pointer border border-white/20 shadow-lg flex items-center justify-center"
      title="Unduh Gambar Dokumentasi"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
      </svg>
    </a>

    <button
      type="button"
      id="closeTransisiModal"
      class="p-3 rounded-full bg-white/10 hover:bg-white/20 text-white transition-all duration-200 focus:outline-none cursor-pointer border border-white/20 shadow-lg"
      aria-label="Tutup Modal"
    >
      <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <div class="relative w-full h-full max-w-6xl max-h-[85vh] flex flex-col items-center justify-center p-2">
    <img
      src={sosialisasiHematEnergiData.gambar}
      alt={sosialisasiHematEnergiData.judul}
      class="max-w-full max-h-[80vh] object-contain mx-auto rounded-lg shadow-2xl"
    />
    <p class="text-white text-xs md:text-sm font-medium mt-3 text-center bg-black/50 px-4 py-2 rounded-full border border-white/10 max-w-2xl">
      {sosialisasiHematEnergiData.caption}
    </p>
  </div>
</div>

<script>
  const modal = document.getElementById("transisiModal");
  const openBtn = document.getElementById("openTransisiModalBtn");
  const triggerImg = document.getElementById("triggerTransisiImg");
  const closeBtn = document.getElementById("closeTransisiModal");

  function openModal() {
    if (modal) {
      modal.classList.remove("hidden");
      document.body.style.overflow = "hidden";
    }
  }

  function closeModal() {
    if (modal) {
      modal.classList.add("hidden");
      document.body.style.overflow = "";
    }
  }

  openBtn?.addEventListener("click", openModal);
  triggerImg?.addEventListener("click", openModal);
  closeBtn?.addEventListener("click", closeModal);

  modal?.addEventListener("click", (e) => {
    if (e.target === modal) closeModal();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && modal && !modal.classList.contains("hidden")) {
      closeModal();
    }
  });
</script>